{
  "name": "redshift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "test:coverage": "vitest run --coverage --coverage.include=src/core --coverage.thresholds.lines=90",
    "validate": "VALIDATE_REPORT=1 vitest run validation",
    "cli:build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist-cli/cli.mjs --log-level=warning",
    "e2e": "node e2e/smoke.cjs",
    "preview:e2e": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.546.0",
    "motion": "^14.14.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-katex": "^3.1.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
